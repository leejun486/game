{
  "name": "dot3d-palace",
  "version": "1.1.0",
  "private": true,
  "description": "월하궁: 도깨비 야행 — 도트 3D 액션 (Three.js)",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --keep-names --format=iife --target=es2020 --outfile=dist/game.js && node tools/stamp.cjs",
    "build:demo": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --define:__DEMO__=true --outfile=dist-demo/game.js",
    "watch": "esbuild src/main.js --bundle --format=iife --target=es2020 --sourcemap --outfile=dist/game.js --watch",
    "serve": "python3 -m http.server 8080",
    "audio": "cd tools/audio && python3 tracks.py && python3 sfx.py",
    "dist:web": "npm run build && python3 tools/pack_web.py",
    "dist:demo": "npm run build:demo && python3 tools/pack_web.py demo",
    "test": "npm run build && node tests/run.cjs",
    "test:only": "node tests/run.cjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "1.56.1"
  }
}
